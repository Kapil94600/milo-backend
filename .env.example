# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api
APP_NAME="Vibe"

# ============================================
# DATABASE (PostgreSQL + Prisma)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_platform?schema=public"

# Docker-specific (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_platform
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================
# JWT
# ============================================
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=change-this-to-another-long-random-string
REFRESH_TOKEN_EXPIRE=30d

# ============================================
# ADMIN
# ============================================
ADMIN_SECRET_KEY=change-this-admin-secret-key
ADMIN_EMAIL=admin@socialplatform.com

# ============================================
# OTP
# ============================================
OTP_EXPIRE=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=logs

# ============================================
# UPLOAD
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
# Base URL for absolute file URLs (used by mobile)
PUBLIC_BASE_URL=http://localhost:5000

# ============================================
# CLOUDINARY (optional)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vibe

# ============================================
# FIREBASE (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================
# RAZORPAY (Payments)
# ============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# SMS
# ============================================
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=VIBE
SMS_TEMPLATE_ID=

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vibe.com

# ============================================
# BUSINESS RULES
# ============================================
SIGNUP_BONUS_COINS=100
REFERRAL_BONUS_COINS=50
DAILY_BONUS_COINS=10
VOICE_CALL_RATE=10
VIDEO_CALL_RATE=20
MESSAGE_COST=1
GIFT_RECEIVER_PERCENT=50
WITHDRAWAL_MIN_AMOUNT=100
WITHDRAWAL_FEE_PERCENT=2

# ============================================
# SOCKET
# ============================================
SOCKET_PORT=5000
SOCKET_PATH=/socket.io

# ============================================
# MAINTENANCE
# ============================================
MAINTENANCE_MODE=false

# ============================================
# DOCKER COMPOSE (optional)
# ============================================
BACKEND_PORT=5000
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081