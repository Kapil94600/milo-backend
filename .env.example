# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api
APP_NAME="Bond"

# ============================================
# DATABASE (PostgreSQL + Prisma)
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bond_db?schema=public"

# Docker-specific
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bond_db
POSTGRES_PORT=5432

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================
# JWT (⚠️ CHANGE IN PRODUCTION — min 32 chars)
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_64_CHAR_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_64_CHAR_RANDOM_STRING
REFRESH_TOKEN_EXPIRE=30d

# ============================================
# ADMIN (⚠️ CHANGE IN PRODUCTION)
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
ADMIN_EMAIL=admin@bond.app

# ============================================
# OTP
# ============================================
OTP_EXPIRE=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ============================================
# CORS
# ============================================
# Comma-separated list — NO WILDCARDS in production
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=logs

# ============================================
# UPLOAD
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
PUBLIC_BASE_URL=http://localhost:5000

# ============================================
# CLOUDINARY (optional but recommended)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bond

# ============================================
# FIREBASE (Push Notifications + Auth) (⚠️ SENSITIVE)
# ============================================
FIREBASE_PROJECT_ID=
# ⚠️ In .env file: use \n for line breaks inside private key
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================
# RAZORPAY (Payments) (⚠️ SENSITIVE)
# ============================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================
# SMS
# ============================================
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=BOND
SMS_TEMPLATE_ID=

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bond.app

# ============================================
# BUSINESS RULES
# ============================================
SIGNUP_BONUS_COINS=100
REFERRAL_BONUS_COINS=50
DAILY_BONUS_COINS=10
VOICE_CALL_RATE=10
VIDEO_CALL_RATE=20
MESSAGE_COST=1
GIFT_RECEIVER_PERCENT=50
WITHDRAWAL_MIN_AMOUNT=100
WITHDRAWAL_FEE_PERCENT=2
COIN_TO_RUPEE_RATE=1
GIRL_PAYOUT_PERCENT=70

# ============================================
# SOCKET
# ============================================
SOCKET_PORT=5000
SOCKET_PATH=/socket.io

# ============================================
# MAINTENANCE
# ============================================
MAINTENANCE_MODE=false

# ============================================
# DOCKER COMPOSE
# ============================================
BACKEND_PORT=5000
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081